{
  "name": "pawproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "node scripts/next.ts dev",
    "dev:direct": "node scripts/next.ts dev local",
    "dev:code-server": "node scripts/next.ts dev code-server",
    "build": "node scripts/next.ts build",
    "start": "node scripts/next.ts start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/next.ts typegen && tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  }
}
