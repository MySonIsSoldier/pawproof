# PawProof — Vercel Production 환경변수 템플릿
# 기본값은 그대로 사용하고 [직접 입력] 15개만 본인 값으로 채우세요.
# 이 파일은 공개 Git 추적 대상입니다. 실제 값은 Vercel 입력란 또는
# Git에서 제외되는 .env.vercel.local 사본에 넣으세요. 기존 .env.local은 덮어쓰지 마세요.
# 상세 안내: docs/operations/VERCEL_DEPLOYMENT.md

# [기본값 유지] package.json의 pnpm 12.3.4 사용
ENABLE_EXPERIMENTAL_COREPACK=1

# [기본값 유지] 운영은 도메인 루트에서 실행합니다.
APP_ENV=production
# [빈칸 유지] /proxy/3000, /absproxy/3000 등을 넣지 마세요.
APP_BASE_PATH=
# [선택] 첫 배포에는 빈칸 유지 가능. 설정할 때는 https://운영-호스트만 입력합니다.
APP_ORIGIN=

# [기본값 유지] 설치형 PWA와 실제 관광/API 흐름 사용
PWA_ENABLED=true
LIVE_SERVICES_ENABLED=true

# [기본값 유지] 현재 로컬에서 사용 중인 모델 ID
OPENROUTER_MODEL=google/gemini-2.5-flash

# [직접 입력 1/15] 한국관광공사 서비스 키 — 기존 로컬에서 동작한 값
KTO_SERVICE_KEY=
# [직접 입력 2/15] OpenRouter API 키
OPENROUTER_API_KEY=
# [직접 입력 3/15] Kakao Mobility REST API 키
KAKAO_MOBILITY_REST_KEY=

# Firebase Admin: 서버 전용. 아래 값에 NEXT_PUBLIC_을 붙이지 마세요.
# [직접 입력 4/15] 서비스 계정 JSON의 project_id
FIREBASE_PROJECT_ID=
# [직접 입력 5/15] 서비스 계정 JSON의 client_email
FIREBASE_CLIENT_EMAIL=
# [직접 입력 6/15] 서비스 계정 JSON의 private_key (JSON 전체가 아닌 PEM 값)
# BEGIN/END 줄 포함. 실제 줄바꿈 또는 문자 \n 지원.
# dotenv 파일에서 여러 줄/\n 값을 쓸 때는 큰따옴표로 감싸세요.
# Vercel의 개별 Value 입력란에는 바깥쪽 따옴표 없이 입력하세요.
FIREBASE_PRIVATE_KEY=

# Firebase Web: Firebase Console → 프로젝트 설정 → 내 앱 → Web SDK 설정
# [직접 입력 7/15] apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=
# [직접 입력 8/15] authDomain — 기존 Firebase 인증 도메인 유지, Vercel 주소로 변경 금지
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# [직접 입력 9/15] projectId — FIREBASE_PROJECT_ID와 동일해야 합니다.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# [직접 입력 10/15] appId
NEXT_PUBLIC_FIREBASE_APP_ID=

# 개발 전용 값(PORT, DEV_ALLOWED_HOSTS, 에뮬레이터 주소)은 이 템플릿에 넣지 않습니다.
# code-server 개발 프로필은 .env.code-server.example → .env.development.local로 분리합니다.
# NODE_ENV, NEXT_PUBLIC_APP_BASE_PATH, PWA_RELEASE_ID는 자동 처리합니다.
# 실제 키/계정 값을 채우기 전에는 실 API·로그인·계정 저장을 사용할 수 없습니다.

# [직접 입력 11/15] 카카오 지도 JavaScript 키 (Mobility REST 키와 다름)
# 운영 KAKAO_MAP_KEY 또는 로컬 NEXT_PUBLIC_KAKAO_MAP_KEY를 지원합니다.
# next.config.ts가 이 JavaScript 키만 공개 빌드 값으로 연결합니다.
# 카카오 앱에서 이용 설정 및 pawproof.kr/배포/개발 도메인 등록 필요.
KAKAO_MAP_KEY=

# Umami self-hosted analytics. Website ID is copied from Umami → Websites → Add website.
# The script is only rendered when NEXT_PUBLIC_UMAMI_WEBSITE_ID is set.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.hothyun.com/script.js
# Optional comma-separated production domains, e.g. pawproof.kr,www.pawproof.kr,pawproof-rose.vercel.app
NEXT_PUBLIC_UMAMI_DOMAINS=

# 문의하기: Resend 발송 설정
# Resend에서 pawproof.kr 도메인을 인증한 뒤 발급한 서버 전용 Sending API key
# [직접 입력 12/15]
RESEND_API_KEY=
# [기본값 변경 가능] 문의 수신 주소
CONTACT_RECIPIENT_EMAIL=ohsong656565@gmail.com
# [직접 입력 13/15] 인증된 발신 주소. 사용자의 이메일을 From으로 넣지 않습니다.
CONTACT_FROM_EMAIL=contact@pawproof.kr
# 운영에서는 Turnstile 검증을 기본 요구합니다. 로컬 테스트만 false로 둘 수 있습니다.
CONTACT_REQUIRE_TURNSTILE=true

# 문의 폼 Turnstile: Cloudflare 대시보드에서 같은 hostname으로 만든 키
# [직접 입력 14/15]
TURNSTILE_SECRET_KEY=
# [직접 입력 15/15] 브라우저에 공개되는 sitekey
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
