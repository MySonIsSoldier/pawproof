# Shared secrets may go in .env.local. Keep app profile values empty here;
# code-server profile overrides belong in .env.development.local.
APP_ENV=
APP_BASE_PATH=
APP_ORIGIN=
DEV_ALLOWED_HOSTS=
PORT=3000

# Server-only values. Required only when the corresponding adapter is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
KTO_SERVICE_KEY=
KAKAO_MOBILITY_REST_KEY=
# Enable only after configuring keys and an OpenRouter per-key credit limit.
LIVE_SERVICES_ENABLED=false

# Firebase Admin: server-only service account. Never use NEXT_PUBLIC for these.
# See docs/engineering/FIREBASE_AUTH_AND_STORAGE.md for console setup.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PWA defaults: production enabled, development disabled.
# Set true and restart to test service workers under the code-server basePath.
PWA_ENABLED=

# Firebase Web app configuration (public identifiers, not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Emulator values are injected by test:firebase only; never set in production.
